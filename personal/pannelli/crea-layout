#!/usr/bin/env python3
"""crea-layout: the brudr-pannelli layout, made from a copy of herdr-transparent.

Usage: crea-layout <herdr-transparent.json> <brudr-pannelli.json>

Same window as the source (look, transparency, sidebar, status), with two changes:
- the right panel's stack "panel-body": six named terminal blocks, one native
  browser block, and before Superfile's block the one of its Nushell view
  (spf-vista, shown by spf-apri in Superfile's place), without a header, on the
  panel's own gray background; after Hunk the PR reviews: the mod block
  "revisioni" and, before it, the web block "revisioni-web" of its V1 prototype
  (the mod writes a review's Lavish session URL there);
- the right panel's column "panel" has no 900 px cap (max PANNELLO_MAX): the Revisioni
  mod widens it by weight to 3/4 of the row, and a cap left the part of the row
  beyond it empty on the right of a wide window;
- the tab bar block "tabs" runs the `pannelli` mod instead of `tabs`, putting
  the side panel buttons in place of Files and Changes.
The ids "files" and "changes" stay. The source file is only read.
"""
import copy
import json
import os
import sys

TITOLO = "brudr pannelli"
# A cap nobody reaches: the panel is 368 px until Revisioni widens it by weight, and then it takes
# 3/4 of the row up to the window's edge, however wide the window.
PANNELLO_MAX = 4000
FIGLI = [
    ("spf-vista", "brudr-spf-vista"),  # before files: see VISTE in mods/pannelli/blocchi.js
    ("files", "brudr-spf"),
    ("neovim", "brudr-nvim"),
    ("changes", "brudr-hunk"),
    ("quota", "brudr-quota"),
    ("tasti", "brudr-tasti"),
    ("privato", "brudr-privato"),
]


def browser():
    return {"id": "browser", "type": "block", "content": {"web": {"url": "https://www.google.com/"}}}


REVISIONI_WEB = "http://127.0.0.1:4388/"  # Lavish's start page until a review is chosen


def revisioni():
    """The PR reviews: the V1 web view, then the mod (same order as ORDINE in blocchi.js)."""
    return [
        {"id": "revisioni-web", "type": "block", "content": {"web": {"url": REVISIONI_WEB}}},
        {"id": "revisioni", "type": "block", "content": {"mod": "revisioni"}},
    ]


def stack():
    terminali = [{"id": id_, "type": "block", "content": {"terminal": nome}} for id_, nome in FIGLI]
    dopo = [i for i, (id_, _) in enumerate(FIGLI) if id_ == "changes"][0] + 1
    return {
        "id": "panel-body",
        "type": "stack",
        "active": "files",
        "children": [*terminali[:dopo], *revisioni(), *terminali[dopo:], browser()],
    }


def nodi(n):
    yield n
    for c in n.get("children", []):
        yield from nodi(c)


def sostituisci(n, nuovo):
    """Replaces the node with id panel-body; returns how many it replaced."""
    trovati = 0
    for i, c in enumerate(n.get("children", [])):
        if c.get("id") == "panel-body":
            n["children"][i] = nuovo
            trovati += 1
        else:
            trovati += sostituisci(c, nuovo)
    return trovati


def crea(sorgente):
    d = copy.deepcopy(sorgente)
    if sostituisci(d, stack()) != 1:
        raise ValueError("the source must have exactly one node with id panel-body")
    schede = [n for n in nodi(d) if n.get("id") == "tabs" and (n.get("content") or {}).get("mod") == "tabs"]
    if len(schede) != 1:
        raise ValueError("the source must have exactly one tab bar block (id tabs, mod tabs)")
    schede[0]["content"]["mod"] = "pannelli"
    pannelli = [n for n in nodi(d) if n.get("id") == "panel"]
    if len(pannelli) != 1:
        raise ValueError("the source must have exactly one right panel (id panel)")
    pannelli[0]["max"] = PANNELLO_MAX
    d["title"] = TITOLO
    d.pop("cloned_from", None)
    return d


def main(argv):
    if len(argv) != 3:
        sys.stderr.write(__doc__)
        return 64
    with open(argv[1], encoding="utf-8") as f:
        d = crea(json.load(f))
    tmp = argv[2] + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(d, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp, argv[2])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
