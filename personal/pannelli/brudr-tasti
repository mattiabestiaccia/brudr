    if not isinstance(righe, list):
        return [], [f"{breve(WORK)}: manca la lista «voci»"]
    voci, scartate = [], 0
    for v in righe[:5000]:
        if not isinstance(v, dict) or not all(isinstance(v.get(c), str) and v.get(c).strip() for c in CAMPI_WORK):
            scartate += 1
            continue
        pulito = {c: re.sub(r"[\x00-\x1f\x7f]", " ", v[c])[:300] for c in CAMPI_WORK}
        voci.append(voce(pulito["programma"], norma(pulito["tasto"]), pulito["azione"], "work", pulito["fonte"], "app",
                         contesto="Work (scritto da un'altra sessione)"))
    avvisi = [f"{breve(WORK)}: {scartate} voci scartate (servono programma, tasto, azione, fonte)"] if scartate else []
    return voci, avvisi


