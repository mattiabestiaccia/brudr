def macos():
    p = casa("Library/Preferences/com.apple.symbolichotkeys.plist")
    with open(p, "rb") as f:
        dati = plistlib.load(f).get("AppleSymbolicHotKeys", {})
    voci = []
    for ident, v in sorted(dati.items(), key=lambda x: int(x[0])):
        if not v.get("enabled"):
