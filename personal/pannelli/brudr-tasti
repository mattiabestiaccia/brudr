def scrivi(d):
    os.makedirs(DATI, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".tasti-", dir=DATI)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(d, f, ensure_ascii=False, indent=1)
        f.write("\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, INDICE)


def genera(forza=False, voce_avanzamento=None):
    """Reads again the sources that changed; returns the index and whether it was written."""
    d = carica()
    progs = d.setdefault("programmi", {})
    cambiato = False
    gruppi = [(nome, lettore, file) for nome, lettore, file in FONTI_D if nome not in SALTA]
    gruppi.append(("a mano", mano, mano_file))
    gruppi.append(("Work", work, lambda: [WORK]))
    for nome, lettore, file in gruppi:
        try:
            t = timbro(file())
        except Exception as e:  # noqa: BLE001 - a source's file list must not stop the others
            t = f"errore {e}"
        vecchio = progs.get(nome)
        if not forza and vecchio and vecchio.get("timbro") == t and not vecchio.get("errore"):
            continue
        if voce_avanzamento:
            voce_avanzamento(nome)
        stato = {"timbro": t, "letto": datetime.datetime.now().isoformat(timespec="seconds")}
        try:
            r = lettore()
            voci, avvisi = r if isinstance(r, tuple) else (r, [])
            stato.update(voci=voci, avvisi=avvisi)
        except FileNotFoundError as e:
            stato.update(voci=[], avvisi=[] if nome in FACOLTATIVI else [f"{nome}: manca {breve(e.filename or '')}"])
        except Exception as e:  # noqa: BLE001 - one broken source is reported, the panel still works
            stato.update(voci=(vecchio or {}).get("voci", []), avvisi=[f"{nome}: non letto ({str(e)[:160]})"],
                         errore=True)
        progs[nome] = stato
        cambiato = True
    for nome in list(progs):
        if nome not in {g[0] for g in gruppi}:
            del progs[nome]
            cambiato = True
    if cambiato:
        d["generato"] = datetime.datetime.now().isoformat(timespec="seconds")
        scrivi(d)
    return d, cambiato


def tutte(d):
    voci = [v for p in d.get("programmi", {}).values() for v in p.get("voci", [])]
    for i, v in enumerate(voci):
        v["id"] = i
    return voci


def avvisi_di(d):
    return [a for p in d.get("programmi", {}).values() for a in p.get("avvisi", [])]


def un_accordo(t):
    return " " not in t and "+" in t and not t.startswith("(")


def conflitti(voci):
    """Same chord, two places: a global shortcut takes the key from everyone else; Herdr's own keys never
    reach the programs in its terminals. Kyria keys are not conflicts: they send the key."""
    per_tasto = {}
    for v in voci:
        chiave = v["tasto"]
        if v["livello"] == "tastiera" and v.get("nota", "").startswith("manda "):
            chiave = v["nota"][6:]
        per_tasto.setdefault(chiave, []).append(v)
    esito = {}
    for tasto, gruppo in per_tasto.items():
        if not un_accordo(tasto):
            continue
        globali = [v for v in gruppo if v["livello"] == "globale"]
        herdr_ = [v for v in gruppo if v["programma"] == "Herdr" and "global" in (v.get("contesto") or "")]
        for v in gruppo:
            note = []
            if v["livello"] == "tastiera":
                continue
            for g in globali:
                if g["programma"] != v["programma"]:
                    note.append(f"{g['programma']} lo prende prima ({g['azione'][:60]})")
            if v["livello"] == "terminale":
                for h in herdr_:
                    note.append(f"Herdr lo prende prima ({h['azione']})")
            if note:
                esito[v["id"]] = sorted(set(note))
    return esito, per_tasto


# ---------------------------------------------------------------- fzf

COLORI = {"utente": "\033[1;33m", "configurato": "\033[33m", "work": "\033[35m", "proposta": "\033[36m"}
GRIGIO, BLU, FINE = "\033[2m", "\033[34m", "\033[0m"


def riga(v, conflitto):
    prog = v["programma"][:11]
    segno = "!" if conflitto else ("*" if v["origine"] in ("utente", "configurato", "work") else " ")
    colore = COLORI.get(v["origine"], "")
    return (f"{v['id']}\t{BLU}{prog:<11}{FINE} {segno}{colore}{v['tasto']:<17}{FINE} "
            f"{v['azione']}{GRIGIO}{'  · ' + v['contesto'] if v.get('contesto') else ''}{FINE}")


def programmi(d):
    nomi = []
    for v in tutte(d):
        if v["programma"] not in nomi:
            nomi.append(v["programma"])
    return nomi


def cmd_righe(argv):
    d = carica()
    voci = tutte(d)
    esito, _ = conflitti(voci)
    filtro = argv[0] if argv and argv[0] not in ("", "Tutti") else None
    out = sys.stdout
    for v in voci:
        if filtro and v["programma"] != filtro:
            continue
        out.write(riga(v, v["id"] in esito) + "\n")
    return 0


def cmd_filtro(argv):
    """fzf transform: the action string that moves the program filter one step."""
    passo = -1 if argv and argv[0] == "-1" else 1
    attuale = (os.environ.get("FZF_PROMPT") or "").split(" ›")[0].strip() or "Tutti"
    nomi = ["Tutti"] + programmi(carica())
    i = nomi.index(attuale) if attuale in nomi else 0
    nuovo = nomi[(i + passo) % len(nomi)]
    io = f"{shlex.quote(sys.executable)} {shlex.quote(os.path.abspath(sys.argv[0]))}"
    print(f"change-prompt({nuovo} › )+reload({io} righe {shlex.quote(nuovo)})+first")
    return 0


def cmd_scheda(argv):
    d = carica()
    voci = tutte(d)
    try:
        v = voci[int(argv[0])]
    except (IndexError, ValueError):
        return 0
    esito, per_tasto = conflitti(voci)
    righe = [f"tasto: {v['tasto']}", f"programma: {v['programma']}", f"azione: {v['azione']}",
             f"origine: {v['origine']}"]
    if v.get("contesto"):
        righe.append(f"contesto: {v['contesto']}")
    righe.append(f"fonte: {v['fonte']}")
    if v.get("nota"):
        righe.append(f"nota: {v['nota']}")
    if v["id"] in esito:
        righe.append("conflitti:")
        righe += [f"  - {c}" for c in esito[v["id"]]]
    chiave = v["nota"][6:] if v["livello"] == "tastiera" and v.get("nota", "").startswith("manda ") else v["tasto"]
    altri = [x for x in per_tasto.get(chiave, []) if x is not v and x["programma"] != v["programma"]]
    if altri:
        righe.append("lo stesso tasto in:" if v["livello"] != "tastiera" else "lo ricevono:")
        righe += [f"  - {x['programma']}: {x['azione'][:70]}" for x in altri[:12]]
    testo = "\n".join(righe) + "\n"
    bat = programma_eseguibile("bat")
    if bat and not os.environ.get("BRUDR_TASTI_SENZA_COLORI"):
        r = subprocess.run([bat, "--language", "yaml", "--color", "always", "--style", "plain", "--paging", "never"],
                           input=testo, capture_output=True, text=True)
        if r.returncode == 0:
            testo = r.stdout
    sys.stdout.write(testo)
    return 0


def cmd_controlla(_argv):
    d, _ = genera()
    voci = tutte(d)
    esito, _ = conflitti(voci)
    for a in avvisi_di(d):
        print(f"avviso: {a}")
    for i, note in sorted(esito.items()):
        v = voci[i]
        print(f"conflitto: {v['programma']} {v['tasto']} ({v['azione'][:50]}): {'; '.join(note)}")
    print(f"{len(voci)} tasti, {len(esito)} in conflitto, {len(avvisi_di(d))} avvisi")
    return 0


def cmd_mostra(_argv):
    fzf = programma_eseguibile("fzf")
    sys.stdout.write("\033[2J\033[HTasti: controllo le fonti…\n")
    sys.stdout.flush()
    d, _ = genera(voce_avanzamento=lambda n: (sys.stdout.write(f"  leggo {n}\n"), sys.stdout.flush()))
    if not fzf:
        sys.stderr.write("brudr-tasti: fzf non trovato\n")
        return 127
    io = os.path.abspath(sys.argv[0])
    avvisi = avvisi_di(d)
    intestazione = "Tab programma · Invio dettagli sì/no · Esc rilegge le fonti"
    if avvisi:
        intestazione += f" · {len(avvisi)} avvisi (brudr-tasti controlla)"
    righe = subprocess.run([sys.executable, io, "righe"], capture_output=True, text=True).stdout
    argv = [fzf, "--ansi", "--exact", "--delimiter", "\t", "--with-nth", "2..",
            "--prompt", "Tutti › ", "--header", intestazione, "--header-first", "--layout", "reverse",
            "--info", "inline-right",
            "--preview", f"{shlex.quote(sys.executable)} {shlex.quote(io)} scheda {{1}}",
            "--preview-window", "down,45%,wrap,border-top",
            "--bind", f"tab:transform:{shlex.quote(sys.executable)} {shlex.quote(io)} filtro +1",
            "--bind", f"shift-tab:transform:{shlex.quote(sys.executable)} {shlex.quote(io)} filtro -1",
            "--bind", "enter:toggle-preview"]
    if os.environ.get("BRUDR_TASTI_FILTRO"):  # tests: the same fzf, without a terminal
        argv += ["--filter", os.environ["BRUDR_TASTI_FILTRO"]]
    r = subprocess.run(argv, input=righe, text=True)
    return 0 if r.returncode in (0, 1, 130) else r.returncode


def main(argv):
    comando = argv[0] if argv else "mostra"
    if comando == "genera":
        d, cambiato = genera(forza="--forza" in argv)
        print(f"{len(tutte(d))} tasti in {breve(INDICE)}" + ("" if cambiato else " (nessuna fonte cambiata)"))
        for a in avvisi_di(d):
            print(f"avviso: {a}")
        return 0
    comandi = {"mostra": cmd_mostra, "righe": cmd_righe, "scheda": cmd_scheda, "filtro": cmd_filtro,
               "controlla": cmd_controlla}
    if comando not in comandi:
        sys.stderr.write(__doc__)
        return 64
    return comandi[comando](argv[1:])


if __name__ == "__main__":
    sys.dont_write_bytecode = True
    sys.exit(main(sys.argv[1:]))
