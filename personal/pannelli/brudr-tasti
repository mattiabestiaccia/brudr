#!/usr/bin/env python3
"""brudr-tasti: the user's key bindings, every program in one list (the Tasti panel of brudr).

Usage:
  brudr-tasti                  update the index if a source changed, then search it with fzf
  brudr-tasti genera [--forza] update the index (all programs with --forza)
  brudr-tasti righe [PROGRAMMA]  the lines fzf shows (tab separated, id first)
  brudr-tasti scheda ID        the details of one line (fzf preview)
  brudr-tasti filtro +1|-1     next or previous program filter (fzf transform)
  brudr-tasti controlla        conflicts, hand lists older than 90 days, sources with errors

The index is ~/.config/herdr-app/data/pannelli/tasti.json. It holds keys, actions
and the paths or addresses of their sources, nothing else: no file contents.
Two kinds of source:
- D, read from the user's files or programs each time they change (Herdr, Claude Code,
  Pi, Neovim, Superfile, Fish, Nushell, Obsidian, macOS, Kyria, Hammerspoon,
  Rectangle, Claude Desktop, Codex, Zed);
- M, lists written once from official pages, one JSON file per program in the
  tasti/ folder next to the index (see personal/pannelli/tasti/).
The Work list (tasti-work.json, written by another session) is read when present;
this program never reads ~/Work.

Keys are written one way for every program: modifiers in the Mac order
ctrl, alt, shift, cmd (then fn), joined with +, then the key: ctrl+alt+h,
alt+shift+cmd+left. A sequence is chords separated by a space: ctrl+x ctrl+k.

Environment (tests): BRUDR_TASTI_CASA (the home the sources are read from),
BRUDR_PANNELLI_DATI (the index folder), BRUDR_TASTI_MANO (the hand lists),
BRUDR_TASTI_SALTA (programs not to read, comma separated), BRUDR_TASTI_PI_DOC,
BRUDR_TASTI_HERDR_PREDEFINITI, BRUDR_TASTI_FILTRO (fzf --filter, no terminal).
"""
import datetime
import hashlib
import json
import os
import plistlib
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import tomllib

CASA = os.environ.get("BRUDR_TASTI_CASA") or os.path.expanduser("~")
DATI = os.environ.get("BRUDR_PANNELLI_DATI") or os.path.join(CASA, ".config/herdr-app/data/pannelli")
INDICE = os.path.join(DATI, "tasti.json")
MANO = os.environ.get("BRUDR_TASTI_MANO") or os.path.join(DATI, "tasti")
WORK = os.path.join(DATI, "tasti-work.json")
HERDR_PREDEFINITI = os.environ.get("BRUDR_TASTI_HERDR_PREDEFINITI") or os.path.join(MANO, "herdr-predefiniti.json")
PI_DOC = os.environ.get("BRUDR_TASTI_PI_DOC") or \
    "/opt/homebrew/lib/node_modules/@earendil-works/pi-coding-agent/docs/keybindings.md"
SALTA = {x.strip() for x in os.environ.get("BRUDR_TASTI_SALTA", "").split(",") if x.strip()}
VERSIONE = 1
VECCHIA = 90  # days: a hand list older than this is flagged
PATH_PROGRAMMI = f"{CASA}/bin:{CASA}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"


def casa(p):
    return os.path.join(CASA, p)


def breve(p):
    """A path as ~/..., the form the index keeps."""
    return "~" + p[len(CASA):] if p == CASA or p.startswith(CASA + "/") else p


# ---------------------------------------------------------------- keys

MODIFICATORI = {
    "ctrl": "ctrl", "control": "ctrl", "ctl": "ctrl", "c": "ctrl", "⌃": "ctrl", "^": "ctrl",
    "alt": "alt", "option": "alt", "opt": "alt", "meta": "alt", "m": "alt", "a": "alt", "⌥": "alt",
    "shift": "shift", "s": "shift", "⇧": "shift",
    "cmd": "cmd", "command": "cmd", "super": "cmd", "mod": "cmd", "d": "cmd", "⌘": "cmd", "gui": "cmd",
    "fn": "fn", "globe": "fn",
}
ORDINE = ["ctrl", "alt", "shift", "cmd", "fn"]
NOMI_TASTI = {
    "left": "left", "right": "right", "up": "up", "down": "down",
    "leftarrow": "left", "rightarrow": "right", "uparrow": "up", "downarrow": "down",
    "←": "left", "→": "right", "↑": "up", "↓": "down", "◀": "left", "▶": "right", "▲": "up", "▼": "down",
    "enter": "enter", "return": "enter", "cr": "enter", "invio": "enter", "⏎": "enter", "↩": "enter", "ret": "enter",
    "escape": "esc", "esc": "esc", "⎋": "esc",
    "tab": "tab", "⇥": "tab", "backtab": "shift+tab",
    "space": "space", "spacebar": "space", "spazio": "space", "spc": "space",
    "backspace": "backspace", "bs": "backspace", "bksp": "backspace", "⌫": "backspace",
    "delete": "delete", "del": "delete", "canc": "delete", "forwarddelete": "delete",
    "pageup": "pageup", "pgup": "pageup", "page-up": "pageup", "pgsu": "pageup",
    "pagedown": "pagedown", "pgdn": "pagedown", "pgdown": "pagedown", "page-down": "pagedown", "pggiù": "pagedown",
    "home": "home", "end": "end", "fine": "end", "insert": "insert",
    "grave": "`", "graveaccent": "`", "comma": ",", "period": ".", "dot": ".", "slash": "/",
    "minus": "-", "plus": "+", "equal": "=", "semicolon": ";", "colon": ":",
    "leftbracket": "[", "rightbracket": "]", "lt": "<", "bar": "|", "bslash": "\\", "backslash": "\\",
    "capslock": "capslock", "caps": "capslock",
}
# Names of several words, made one before splitting a sequence on spaces.
PIU_PAROLE = [
    (r"space\s*bar", "space"), (r"(left|right|up|down)\s+arrow", r"\1"), (r"page\s+(up|down)", r"page\1"),
    (r"grave\s+accent(\s*\(`\))?", "grave"), (r"forward\s+delete", "forwarddelete"), (r"caps\s+lock", "capslock"),
    (r"left\s+(curly\s+)?bracket(\s*\(\{\))?", "leftbracket"), (r"right\s+(curly\s+)?bracket(\s*\(\}\))?", "rightbracket"),
    (r"comma\s*\(,\)", "comma"), (r"period\s*\(\.\)", "period"), (r"slash\s*\(/\)", "slash"),
    (r"minus\s+sign\s*\(-\)", "minus"), (r"plus\s+sign\s*\(\+\)", "plus"), (r"equal\s+sign\s*\(=\)", "equal"),
    (r"colon\s*\(:\)", "colon"), (r"semicolon\s*\(;\)", "semicolon"), (r"question\s+mark\s*\(\?\)", "?"),
    (r"vertical\s+bar\s*\(\|\)", "bar"),
]
RE_MOD = re.compile(r"^(ctrl|control|ctl|alt|option|opt|meta|shift|cmd|command|super|mod|fn|globe|hyper|[⌃⌥⇧⌘])\s*(?:[+-]\s*|(?=[⌃⌥⇧⌘]))", re.I)
RE_SIMBOLI = re.compile(r"^([⌃⌥⇧⌘]+)(.+)$")


def accordo(testo):
    """One chord in any of the spellings the sources use -> ctrl+alt+shift+cmd+key."""
    t = testo.strip()
    if not t:
        return ""
    mods = set()
    m = RE_SIMBOLI.match(t)  # ⌃⌥H, ⌘⇧P
    if m and not t.startswith(("⌃+", "⌥+", "⇧+", "⌘+")):
        mods.update(MODIFICATORI[c] for c in m[1])
        t = m[2]
    while True:
        m = RE_MOD.match(t)
        if not m or len(t) == len(m[0]):
            break
        nome = m[1].lower()
        if nome == "hyper":
            mods.update(("ctrl", "alt", "shift", "cmd"))
        else:
            mods.add(MODIFICATORI[nome])
        t = t[len(m[0]):]
    chiave = t.strip()
    nome = NOMI_TASTI.get(chiave.lower().replace(" ", ""), None)
    if nome is None:
        nome = chiave.lower() if (mods and len(chiave) == 1) else chiave
        if len(chiave) > 1 and re.fullmatch(r"[A-Za-z]\w*", chiave):
            nome = chiave.lower()
    if "+" in nome and nome != "+":  # backtab
        extra, nome = nome.rsplit("+", 1)
        mods.add(extra)
    return "+".join([x for x in ORDINE if x in mods] + [nome])


def norma(testo):
    """A key or a sequence of chords (separated by spaces) in the shared spelling."""
    t = str(testo).strip()
    for a, b in PIU_PAROLE:
        t = re.sub(a, b, t, flags=re.I)
    t = re.sub(r"\s*\+\s*(?=\S)", "+", t)  # "⌘ + Shift + n"
    return " ".join(accordo(p) for p in t.split())


VIM_SPECIALI = {"cr": "enter", "esc": "esc", "tab": "tab", "bs": "backspace", "space": "space", "leader": "<leader>",
                "localleader": "<localleader>", "lt": "<", "bar": "|", "bslash": "\\", "del": "delete", "nl": "ctrl+j",
                "up": "up", "down": "down", "left": "left", "right": "right", "home": "home", "end": "end",
                "pageup": "pageup", "pagedown": "pagedown", "s-tab": "shift+tab", "nop": ""}


def tasto_vim(lhs):
    """A Neovim left-hand side -> chords: <C-w>v -> ctrl+w v, ' ff' -> <leader> f f."""
    parti = []
    i = 0
    if lhs.startswith(" "):
        parti.append("<leader>")
        i = 1
    while i < len(lhs):
        if lhs[i] == "<":
            j = lhs.find(">", i)
            if j > i + 1:
                dentro = lhs[i + 1:j]
                low = dentro.lower()
                if low in VIM_SPECIALI:
                    parti.append(VIM_SPECIALI[low])
                elif re.fullmatch(r"([cmasd]-)+.+", low):
                    *mods, chiave = dentro.split("-") if not dentro.endswith("--") else (*dentro[:-2].split("-"), "-")
                    nomi = {MODIFICATORI[x.lower()] for x in mods if x}
                    k = VIM_SPECIALI.get(chiave.lower(), chiave)
                    k = k.lower() if len(k) == 1 and "shift" not in nomi else k
                    parti.append("+".join([x for x in ORDINE if x in nomi] + [k]))
                elif re.fullmatch(r"f\d+", low):
                    parti.append(low)
                else:
                    parti.append(f"<{dentro}>")
                i = j + 1
                continue
        parti.append(lhs[i])
        i += 1
    # Plain characters next to each other are one Vim word (gg, ]h): keep them together.
    uscita = []
    for p in parti:
        if uscita and len(p) == 1 and len(uscita[-1]) >= 1 and "+" not in uscita[-1] and not uscita[-1].startswith("<") \
                and uscita[-1] not in VIM_SPECIALI.values():
            uscita[-1] += p
        else:
            uscita.append(p)
    return " ".join(x for x in uscita if x)


# ---------------------------------------------------------------- helpers

def leggi_json(p):
    with open(p, encoding="utf-8") as f:
        return json.load(f)


def esegui(argv, timeout=60, env=None, input_=None):
    e = dict(os.environ, PATH=PATH_PROGRAMMI)
    if env:
        e.update(env)
    r = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, env=e, input=input_,
                       stdin=None if input_ is not None else subprocess.DEVNULL)
    if r.returncode != 0:
        raise RuntimeError(f"{os.path.basename(argv[0])}: uscita {r.returncode}: {r.stderr.strip()[:200]}")
    return r.stdout


def programma_eseguibile(nome):
    return shutil.which(nome, path=PATH_PROGRAMMI)


def voce(programma, tasto, azione, origine, fonte, livello, contesto=None, nota=None):
    v = {"programma": programma, "tasto": tasto, "azione": " ".join(str(azione).split()), "origine": origine,
         "fonte": fonte, "livello": livello}
    if contesto:
        v["contesto"] = contesto
    if nota:
        v["nota"] = nota
    return v


def umano(nome):
    """open_file_with_editor -> open file with editor; cursorWordLeft -> cursor word left."""
    nome = re.sub(r"([a-z])([A-Z])", r"\1 \2", nome.split(".")[-1].split(":")[-1])
    return nome.replace("_", " ").lower()


# ---------------------------------------------------------------- sources (D)

def herdr():
    utente = casa(".config/herdr-app/keys.json")
    try:
        predefiniti = leggi_json(HERDR_PREDEFINITI)
    except (OSError, ValueError):
        predefiniti = {}
    voci = []
    if not os.path.exists(utente):
        sezioni, origine_tutti = predefiniti, "predefinito"
    else:
        sezioni, origine_tutti = leggi_json(utente), None
    for sezione, mappa in sezioni.items():
        if not isinstance(mappa, dict):
            continue
        base = predefiniti.get(sezione, {}) if isinstance(predefiniti.get(sezione), dict) else {}
        for tasto, azione in mappa.items():
            if origine_tutti:
                origine = origine_tutti
            else:
                origine = "predefinito" if base.get(tasto) == azione else "utente"
            if isinstance(azione, str) and azione.startswith("send:"):
                azione = "manda " + json.dumps(azione[5:])[1:-1]
            voci.append(voce("Herdr", norma(tasto), azione, origine, breve(utente) if not origine_tutti else
                             breve(HERDR_PREDEFINITI), "app", contesto=f"keys.json · {sezione}"))
    return voci


def herdr_file():
    return [casa(".config/herdr-app/keys.json"), HERDR_PREDEFINITI]


def claude_code():
    p = casa(".claude-brus/keybindings.json")
    voci = []
    if os.path.exists(p):
        for blocco in leggi_json(p).get("bindings", []):
            for tasto, azione in (blocco.get("bindings") or {}).items():
                testo = f"esegue /{azione[8:]}" if isinstance(azione, str) and azione.startswith("command:") else \
                    ("tasto tolto" if azione is None else azione)
                voci.append(voce("Claude Code", norma(tasto), testo, "utente", breve(p), "terminale",
                                 contesto=blocco.get("context")))
    return voci


def pi():
    """Pi: defaults from its own docs, the user's keybindings.json over them."""
    utente = casa(".pi/agent/keybindings.json")
    sue = leggi_json(utente) if os.path.exists(utente) else {}
    voci = []
    sezione = None
    if os.path.exists(PI_DOC):
        with open(PI_DOC, encoding="utf-8") as f:
            for riga in f:
                if riga.startswith("#"):
                    sezione = riga.strip("# \n")
                m = re.match(r"\|\s*`([\w.]+)`\s*\|\s*(.*?)\s*\|\s*(.*?)\s*\|\s*$", riga)
                if not m or m[1] in sue:
                    continue
                for t in re.findall(r"`([^`]+)`", m[2]):
                    voci.append(voce("Pi", norma(t), f"{m[3]} ({m[1]})", "predefinito", PI_DOC, "terminale",
                                     contesto=sezione))
    for azione, tasti in sue.items():
        if not tasti:
            voci.append(voce("Pi", "(nessuno)", f"{umano(azione)} ({azione}): tolto dall'utente", "utente",
                             breve(utente), "terminale"))
        for t in tasti if isinstance(tasti, list) else [tasti]:
            voci.append(voce("Pi", norma(t), f"{umano(azione)} ({azione})", "utente", breve(utente), "terminale"))
    return voci


def pi_file():
    return [casa(".pi/agent/keybindings.json"), PI_DOC]


NVIM_LUA = r"""
vim.api.nvim_exec_autocmds("User", { pattern = "VeryLazy" })
local out = {}
for _, mode in ipairs({ "n", "i", "v", "x", "o", "c", "t", "s" }) do
  for _, m in ipairs(vim.api.nvim_get_keymap(mode)) do
    table.insert(out, { mode = mode, lhs = m.lhs, desc = m.desc or "", rhs = m.rhs or "" })
  end
end
local f = io.open(os.getenv("BRUDR_TASTI_NVIM_OUT"), "w")
f:write(vim.json.encode(out))
f:close()
"""
MODI_VIM = {"n": "normale", "i": "inserimento", "v": "visuale e selezione", "x": "visuale", "o": "operatore",
            "c": "riga di comando", "t": "terminale", "s": "selezione"}


def neovim():
    """The maps Neovim has after LazyVim's VeryLazy, read headless: no swap, shada or state left behind."""
    nvim = programma_eseguibile("nvim")
    if not nvim:
        raise RuntimeError("nvim non trovato")
    keymaps = casa(".config/nvim/lua/config/keymaps.lua")
    sue = set()
    if os.path.exists(keymaps):
        with open(keymaps, encoding="utf-8") as f:
            for modi, lhs in re.findall(r"vim\.keymap\.set\(\s*(\{[^}]*\}|\"\w+\")\s*,\s*\"([^\"]+)\"", f.read()):
                for m in re.findall(r"\w+", modi):
                    sue.add((m, tasto_vim(lhs)))
    with tempfile.TemporaryDirectory(prefix="brudr-tasti-nvim-") as d:
        script, out = os.path.join(d, "mappe.lua"), os.path.join(d, "mappe.json")
        with open(script, "w") as f:
            f.write(NVIM_LUA)
        esegui([nvim, "--headless", "-n", "-i", "NONE", f"+luafile {script}", "+qa!"], timeout=120,
               env={"BRUDR_TASTI_NVIM_OUT": out, "XDG_STATE_HOME": os.path.join(d, "state"),
                    "XDG_CACHE_HOME": os.path.join(d, "cache"), "HOME": CASA})
        mappe = leggi_json(out)
    voci, viste = [], set()
    for m in mappe:
        lhs, desc, rhs = m.get("lhs", ""), m.get("desc", ""), m.get("rhs", "")
        if lhs.startswith("<Plug>") or "<SNR>" in lhs or (not desc and rhs.startswith("<Plug>")):
            continue
        tasto = tasto_vim(lhs)
        chiave = (m["mode"], tasto)
        if chiave in viste or not tasto:
            continue
        viste.add(chiave)
        azione = desc or rhs or "(funzione Lua)"
        origine = "utente" if chiave in sue or (m["mode"] in "xv" and ("v", tasto) in sue) else "predefinito"
        voci.append(voce("Neovim", tasto, azione, origine, breve(keymaps) if origine == "utente" else
                         "LazyVim e plugin", "terminale", contesto=f"modo {MODI_VIM.get(m['mode'], m['mode'])}"))
    return voci


def neovim_file():
    # The config tree and the plugins' lock: a change in either changes the maps.
    base = casa(".config/nvim")
    file = [os.path.join(base, "lazy-lock.json"), os.path.join(base, "init.lua"), programma_eseguibile("nvim") or ""]
    for radice, _, nomi in os.walk(os.path.join(base, "lua")):
        file.extend(os.path.join(radice, n) for n in sorted(nomi) if n.endswith(".lua"))
    return file


def superfile():
    p = casa("Library/Application Support/superfile/hotkeys.toml")
    with open(p, "rb") as f:
        dati = tomllib.load(f)
    nomi = {}
    try:  # what each action does, from the official list (hand file)
        for v in leggi_json(os.path.join(MANO, "superfile.json")).get("voci", []):
            if v.get("variabile"):
                nomi[v["variabile"]] = v["azione"]
    except (OSError, ValueError):
        pass
    voci = []
    for azione, tasti in dati.items():
        if not isinstance(tasti, list):
            continue
        for t in tasti:
            if t:
                voci.append(voce("Superfile", norma(t), nomi.get(azione, umano(azione)) + f" ({azione})", "utente",
                                 breve(p), "terminale"))
    return voci


def fish():
    fish_ = programma_eseguibile("fish")
    if not fish_:
        raise RuntimeError("fish non trovato")
    voci = []
    uscita = esegui([fish_, "--no-config", "-c", "fish_vi_key_bindings; bind"], timeout=30, env={"HOME": CASA})
    config = casa(".config/fish/config.fish")
    righe = [("predefinito", r) for r in uscita.splitlines()]
    if os.path.exists(config):
        with open(config, encoding="utf-8") as f:
            righe += [("utente", r.strip()) for r in f if r.strip().startswith("bind ")]
    for origine, riga in righe:
        if not riga.startswith("bind "):
            continue
        try:
            parole = shlex.split(riga.replace("\\n", " "), posix=True)[1:]
        except ValueError:
            continue
        modo, nuovo = "default", None
        while parole and parole[0].startswith("-"):
            p = parole.pop(0)
            if p in ("-M", "--mode") and parole:
                modo = parole.pop(0)
            elif p in ("-m", "--sets-mode") and parole:
                nuovo = parole.pop(0)
        if not parole:
            continue
        chiave, *comando = parole
        azione = " ".join(comando)
        if len(azione) > 90 or "\n" in azione:
            azione = azione[:87] + "…"
        if nuovo:
            azione += f" → modo {nuovo}"
        tasto = " ".join(accordo(c.replace("-", "+") if re.match(r"^(ctrl|alt|shift|super)-", c) else c)
                         for c in chiave.split(","))
        voci.append(voce("Fish", tasto, azione or "(niente)", origine, breve(config) if origine == "utente" else
                         "fish_vi_key_bindings", "terminale", contesto=f"modo {modo}"))
    return voci


def fish_file():
    return [casa(".config/fish/config.fish"), programma_eseguibile("fish") or ""]


def tasto_nu(modificatore, codice):
    mods = set()
    m = str(modificatore).lower()
    for parola, nome in (("control", "ctrl"), ("alt", "alt"), ("shift", "shift"), ("super", "cmd")):
        if parola in m:
            mods.add(nome)
    c = str(codice)
    mm = re.fullmatch(r"(?:char_|Char\(')(.+?)(?:'\))?", c)
    k = mm[1] if mm else c
    k = NOMI_TASTI.get(k.lower().replace("_", ""), k.lower() if len(k) > 1 else k)
    if "+" in k and k != "+":  # backtab is shift+tab
        extra, k = k.rsplit("+", 1)
        mods.add(extra)
    return "+".join([x for x in ORDINE if x in mods] + [k])


def evento_nu(e):
    if isinstance(e, dict):
        if "until" in e:
            return " o ".join(evento_nu(x) for x in e["until"])
        return " ".join(f"{v}" for v in e.values())
    if isinstance(e, list):
        return ", ".join(evento_nu(x) for x in e)
    return str(e)


def nushell():
    nu = programma_eseguibile("nu")
    if not nu:
        raise RuntimeError("nu non trovato")
    config = casa("Library/Application Support/nushell/config.nu")
    voci = []
    # The keybindings of the config (Nushell's own, unless the user adds some), with his config loaded.
    dati = json.loads(esegui([nu, "-c", "{mode: $env.config.edit_mode, kb: $env.config.keybindings} | to json -r"],
                             timeout=30, env={"HOME": CASA}))
    modo = dati.get("mode", "emacs")
    for k in dati.get("kb", []):
        voci.append(voce("Nushell", tasto_nu(k.get("modifier"), k.get("keycode")),
                         f"{k.get('name', '')}: {evento_nu(k.get('event'))}", "predefinito", breve(config) +
                         " ($env.config.keybindings)", "terminale", contesto="tutti i modi"))
    predef = json.loads(esegui([nu, "--no-config-file", "-c", f"keybindings default | where mode == '{modo}' | to json -r"],
                               timeout=30))
