def work():
    """The Work list written by another session: only text fields, bounded, nothing else kept."""
    if not os.path.exists(WORK):
        return [], []
    try:
        if os.path.getsize(WORK) > 1024 * 1024:
            return [], [f"{breve(WORK)}: più di 1 MiB, non letto"]
        d = leggi_json(WORK)
    except (OSError, ValueError) as e:
        return [], [f"{breve(WORK)}: non leggibile ({e})"]
