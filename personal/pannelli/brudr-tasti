def kyria():
    """The Kyria's layers from the generated Kyria page (layer/tastiera-layer.html, from the current .vil)."""
    p = casa("personal/personalizzazioni/kyria/layer/tastiera-layer.html")
    testo = open(p, encoding="utf-8").read()
    i = testo.find('{"layers"')
    if i < 0:
        raise RuntimeError("nessun dato dei layer nella pagina della Kyria")
    dati, _ = json.JSONDecoder().raw_decode(testo[i:])
    base = next((l for l in dati["layers"] if l["id"] == "base"), {"keys": {}})
    etichetta = {k: (v.get("eff") or k).split(" ")[0] for k, v in base["keys"].items()}
    voci = []
    for layer in dati["layers"]:
        for kid, k in layer["keys"].items():
            if k.get("free") or k.get("trns"):
                continue
            nome = f"{layer['name']} {etichetta.get(kid, kid)}"
            descr = " · ".join(x for x in (k.get("eff"), k.get("tm") if k.get("tm") not in (None, "—") else None,
                                           f"nvim: {k['nv']}" if k.get("nv") not in (None, "—") else None) if x)
            gesti = k.get("td") or {}
            if gesti:
                for gesto, g in gesti.items():
                    manda = kyria_manda(g.get("cmd", ""))
                    voci.append(voce("Kyria", f"{nome} {gesto}", f"→ {manda} · {g.get('eff') or ''} · {descr}",
                                     "utente", breve(p), "tastiera", contesto=f"layer {layer['name']}",
                                     nota=f"manda {manda}"))
                continue
            cmd = k.get("cmd", "")
            if cmd.startswith("tieni: layer") or cmd in ("", "—", "▽"):
                if cmd.startswith("tieni"):
                    voci.append(voce("Kyria", nome, cmd, "utente", breve(p), "tastiera", contesto=f"layer {layer['name']}"))
                continue
            manda = kyria_manda(cmd)
            if layer["id"] == "base" and len(manda) == 1 and not descr.strip(manda.upper()):
                continue  # a plain letter of the Base layer
            voci.append(voce("Kyria", nome, f"→ {manda}" + (f" · {descr}" if descr else ""), "utente", breve(p),
                             "tastiera", contesto=f"layer {layer['name']}", nota=f"manda {manda}"))
    return voci


KYRIA_NOMI = {"Invio": "enter", "Spazio": "space", "Bksp": "backspace", "Canc": "delete", "Esc": "esc",
              "Tab": "tab", "PgSu": "pageup", "PgGiù": "pagedown", "Fine": "end", "Home": "home"}


def kyria_manda(cmd):
    """Ctrl+Option+H -> ctrl+alt+h; a macro of several keys stays as written."""
    if " · " in cmd or not cmd:
        return cmd
    parti = cmd.split("+")
    parti[-1] = KYRIA_NOMI.get(parti[-1], parti[-1])
    return norma("+".join(parti)) if len(parti[-1]) <= 9 else cmd


