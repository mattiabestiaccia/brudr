def tasto_mac(keycode, flags):
    mods = [nome for bit, nome in FLAG if flags & bit and not (nome == "fn" and keycode in TASTI_FUNZIONE)]
    return "+".join(mods + [KEYCODE.get(keycode, f"tasto {keycode}")])


