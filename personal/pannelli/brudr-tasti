def timbro(file):
    h = hashlib.sha256()
    for p in file:
        try:
            s = os.stat(p)
            h.update(f"{p}\0{s.st_mtime_ns}\0{s.st_size}\n".encode())
        except OSError:
            h.update(f"{p}\0-\n".encode())
    return h.hexdigest()[:16]


